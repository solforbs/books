# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=3000

# PostgreSQL. `pnpm dev` starts an embedded server on 127.0.0.1:5433 and creates both roles
# with these passwords (local only). Two roles, on purpose:
#   DATABASE_URL            books_app: what every request uses. Not a superuser, no BYPASSRLS,
#                           owns no tables, so row-level security always applies to it.
#   DATABASE_MIGRATION_URL  books_owner: owns the tables; used only at startup to apply
#                           migrations (apps/api/drizzle), then disconnected. Optional: when
#                           unset, migrations run with DATABASE_URL.
DATABASE_URL=postgres://books_app:books_app_dev@127.0.0.1:5433/books
DATABASE_MIGRATION_URL=postgres://books_owner:books_owner_dev@127.0.0.1:5433/books

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters; the two secrets must be different.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# true behind HTTPS (required when NODE_ENV=production); false for plain-http local dev.
COOKIE_SECURE=false

# The web app origin allowed by CORS.
WEB_ORIGIN=http://localhost:5173

# Which proxies in front of the API may set X-Forwarded-For (used for per-IP rate limits
# and the audit log). One of:
#   false             - no proxy (default; local dev)
#   1                 - number of trusted proxy hops. PRODUCTION: TRUST_PROXY=1 (the
#                       container nginx, which forwards the real client IP it got from the
#                       host web server). The hops are only trusted when the API's direct
#                       peer is on a loopback/private network, as nginx is on the Docker one.
#   10.0.0.2,172.18.0.0/16 - only these proxy IPs / CIDRs are trusted
# "true" (trust everyone) is refused at startup: clients could forge their IP.
# TRUST_PROXY=false

# In production the API refuses to start while a JWT secret still starts with "replace-with".

# Optional
# RATE_LIMIT_PER_MINUTE=120       # per IP, per route
# AUTH_RATE_LIMIT_PER_MINUTE=10   # per IP, for login / register / recover
