{
  "name": "@books/api",
  "version": "0.1.0",
  "private": true,
  "description": "Books API: NestJS (Fastify) modular monolith",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:db": "node scripts/dev-db.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@books/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.11.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.11.0-beta.19",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.4"
  }
}
