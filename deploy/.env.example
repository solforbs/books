# Copy to deploy/.env on the VPS and fill in. Never commit the real file.
# Generate EACH value separately with:  openssl rand -hex 32
# (hex keeps them safe inside the database URLs; every value must be different).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# PostgreSQL superuser: administration and backups only.
POSTGRES_PASSWORD=
# books_owner: owns the tables, used by the API only to apply migrations at startup.
BOOKS_OWNER_PASSWORD=
# books_app: every API request; no superuser, no BYPASSRLS, cannot delete or alter tables.
BOOKS_APP_PASSWORD=
# The three database passwords are set when the data volume is first created; changing
# them here later needs an ALTER ROLE as well (see deploy/README.md).
